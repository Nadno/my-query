{
  "name": "mini-stack",
  "main": "./dist/mini-stack.cjs",
  "module": "./dist/mini-stack.mjs",
  "exports": {
    ".": {
      "import": "./dist/mini-stack.mjs",
      "require": "./dist/mini-stack.cjs"
    }
  },
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:query-selection": "vitest run ./src/__tests__/query-selection.test.ts --reporter verbose"
  },
  "devDependencies": {
    "@types/jsdom": "^20.0.1",
    "@typescript-eslint/eslint-plugin": "^5.46.0",
    "@typescript-eslint/parser": "^5.46.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^8.5.0",
    "happy-dom": "^20.6.1",
    "jsdom": "^20.0.3",
    "prettier": "^2.8.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.6.4",
    "vite": "^3.2.3",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^0.25.6"
  },
  "dependencies": {
    "ts-mixer": "^6.0.2"
  }
}
